{
  "name": "ts-full-type-viewer",
  "displayName": "Full Type Viewer",
  "description": "Shows complete, lazily expandable TypeScript 7 alias types in a dedicated sidebar view.",
  "version": "0.0.3",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.126.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:fullTypeViewer.type"
  ],
  "extensionDependencies": [
    "TypeScriptTeam.native-preview"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fullTypeViewer",
          "title": "Full Type Viewer",
          "icon": "resources/full-type-viewer.svg"
        }
      ]
    },
    "views": {
      "fullTypeViewer": [
        {
          "id": "fullTypeViewer.type",
          "name": "Full Type",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "fullTypeViewer.refresh",
        "title": "Full Type Viewer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "fullTypeViewer.expandLevel",
        "title": "Full Type Viewer: Expand One Level",
        "icon": "$(expand-all)"
      },
      {
        "command": "fullTypeViewer.collapseAll",
        "title": "Full Type Viewer: Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "fullTypeViewer.copy",
        "title": "Full Type Viewer: Copy",
        "icon": "$(copy)"
      },
      {
        "command": "fullTypeViewer.enableWordWrap",
        "title": "Full Type Viewer: Enable Word Wrap",
        "icon": "$(word-wrap)"
      },
      {
        "command": "fullTypeViewer.disableWordWrap",
        "title": "Full Type Viewer: Disable Word Wrap",
        "icon": "$(word-wrap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fullTypeViewer.enableWordWrap",
          "when": "view == fullTypeViewer.type && !fullTypeViewer.wordWrap",
          "group": "navigation@1"
        },
        {
          "command": "fullTypeViewer.disableWordWrap",
          "when": "view == fullTypeViewer.type && fullTypeViewer.wordWrap",
          "group": "navigation@1"
        },
        {
          "command": "fullTypeViewer.refresh",
          "when": "view == fullTypeViewer.type",
          "group": "navigation@2"
        },
        {
          "command": "fullTypeViewer.expandLevel",
          "when": "view == fullTypeViewer.type",
          "group": "navigation@3"
        },
        {
          "command": "fullTypeViewer.collapseAll",
          "when": "view == fullTypeViewer.type",
          "group": "navigation@4"
        },
        {
          "command": "fullTypeViewer.copy",
          "when": "view == fullTypeViewer.type",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "fullTypeViewer.enableWordWrap",
          "when": "!fullTypeViewer.wordWrap"
        },
        {
          "command": "fullTypeViewer.disableWordWrap",
          "when": "fullTypeViewer.wordWrap"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:integration": "npm run build && node .test-build/runIntegration.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --out ts-full-type-viewer-0.0.3.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@types/node": "24.3.0",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.3.2",
    "esbuild": "0.25.12",
    "vitest": "4.0.18"
  },
  "overrides": {
    "jws": "4.0.0"
  },
  "files": [
    "dist/extension.js",
    "dist/extension.js.map",
    "dist/webview.js",
    "resources/full-type-viewer.svg",
    "README.md",
    "LICENSE"
  ]
}
